# 将这些配置加入现有 NoneBot 项目的 .env / .env.prod。
SUPERUSERS=["你的QQ号"]
STEAM_FAMILY_DATA_DIR="data/steam_family_watchdog"
STEAM_FAMILY_POLL_SECONDS=300
STEAM_FAMILY_JITTER_SECONDS=10
STEAM_FAMILY_PUSH_GROUPS=["群号1","群号2"]
STEAM_FAMILY_PUSH_USERS=["个人QQ号"]
STEAM_FAMILY_LANGUAGE="schinese"
STEAM_FAMILY_SEND_IMAGES=true
STEAM_FAMILY_REPLAY_HISTORY=false
STEAM_FAMILY_WEB_ENABLED=true
STEAM_FAMILY_WEB_HOST="0.0.0.0"
STEAM_FAMILY_WEB_PORT=11454
# 留空自动生成 data/steam_family_watchdog/web-token.txt。
STEAM_FAMILY_WEB_TOKEN=""
# 多 Bot 时可指定发送方；留空绑定首次执行 steam启动 的 Bot。
STEAM_FAMILY_BOT_ID=""
